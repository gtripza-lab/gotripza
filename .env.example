# GoTripza — Environment template (safe to commit)
# Copy to .env.local and fill in your real values
# ─────────────────────────────────────────────────────────────────────────────

# ── AI (OpenAI) ───────────────────────────────────────────────────────────────
# Server-only — never use NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=

# Primary model for intent extraction, clarify/search/advice decisions.
AI_MODEL_PRIMARY=gpt-4o
# Lite model for tips, descriptions, summaries (lower cost).
AI_MODEL_LITE=gpt-4o-mini

# OpenAI Agent Builder workflow IDs.
# Copy each workflow ID from Platform → Agent Builder → your workflow → Code/Deploy.
OPENAI_WORKFLOW_SEO_AGENT_ID=
OPENAI_WORKFLOW_MARKETING_AGENT_ID=
OPENAI_WORKFLOW_TRAVEL_RESEARCH_AGENT_ID=
OPENAI_WORKFLOW_SUPPORT_DRAFT_AGENT_ID=
OPENAI_WORKFLOW_ANALYTICS_INSIGHT_AGENT_ID=

# ── Travelpayouts ─────────────────────────────────────────────────────────────
# This is the SINGLE affiliate tracking backbone for ALL partners.
# Every partner link routes through: tp.media/click?shmarker=MARKER&promo_id=...
#
# Your marker ID — find it at: https://www.travelpayouts.com/dashboard
NEXT_PUBLIC_TRAVELPAYOUTS_MARKER=522867
# API token — for Aviasales flight prices & Hotellook hotel prices
TRAVELPAYOUTS_TOKEN=

# ── Travelpayouts Partner Promo IDs ───────────────────────────────────────────
# HOW TO GET YOUR PROMO IDs:
#   1. https://www.travelpayouts.com/programs
#   2. Click the partner you are enrolled in
#   3. Tools → Links → copy the number after "promo_id="
#
# ── Hotels (universal defaults — no change needed) ──────────────────────────
NEXT_PUBLIC_TP_PROMO_BOOKING=4338
NEXT_PUBLIC_TP_PROMO_TRIPCOM=4064

# ── All other partners — fill from your TP dashboard ────────────────────────
# Car Rental
NEXT_PUBLIC_TP_PROMO_DISCOVERCARS=

# Activities & Attractions
NEXT_PUBLIC_TP_PROMO_GYG=
NEXT_PUBLIC_TP_PROMO_KLOOK=
NEXT_PUBLIC_TP_PROMO_KKDAY=
NEXT_PUBLIC_TP_PROMO_GOCITY=

# Cheap Flights
NEXT_PUBLIC_TP_PROMO_KIWI=
NEXT_PUBLIC_TP_PROMO_CHEAPOAIR=

# eSIM / Mobile Data
NEXT_PUBLIC_TP_PROMO_AIRALO=
NEXT_PUBLIC_TP_PROMO_YESIM=

# Travel Insurance
NEXT_PUBLIC_TP_PROMO_VC=
NEXT_PUBLIC_TP_PROMO_EKTA=

# Flight Compensation
NEXT_PUBLIC_TP_PROMO_AIRHELP=

# Train Travel
NEXT_PUBLIC_TP_PROMO_RAILEUROPE=

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Rate limiting / abuse protection ─────────────────────────────────────────
# Recommended in production for Vercel serverless. If unset, server routes use
# Supabase RPC; local development may fall back to in-memory limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_KEY=
# Optional: use ADMIN_KEY as x-health-key for /api/internal/health.

# ── Analytics ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18132778368
NEXT_PUBLIC_GOOGLE_ADS_CONV_LABEL=dKO-CJzP264cEID7sMZD

# ── Travelpayouts webhook secret ──────────────────────────────────────────────
# REQUIRED in production — webhook returns 503 when unset (no insecure default)
TP_WEBHOOK_SECRET=

# ── Error tracking (optional — Sentry) ────────────────────────────────────────
# Set SENTRY_DSN to capture production errors. Without it, errors fall back to
# console.error. Install @sentry/nextjs to activate.
SENTRY_DSN=

# ── Stripe (Ria Plus subscription) ────────────────────────────────────────────
# Premium is FREE during launch (plan='launch_free' in DB grants premium access
# without a Stripe customer). Set these when ready to enable paid plans.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key for client (only if you mount Stripe Elements in browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Price IDs for the Ria Plus subscription tiers
STRIPE_PRICE_RIA_PLUS_MONTHLY=
STRIPE_PRICE_RIA_PLUS_YEARLY=
# When true, gate premium features behind subscription. When false (launch
# default), every signed-in user is treated as premium via launch_free plan.
RIA_PLUS_GATING_ENABLED=false

# ── Unsplash ──────────────────────────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=
